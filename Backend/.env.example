

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database (Supabase / PostgreSQL)
# Use URL-encoded password if it contains special characters (@ → %40)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
JWT_VERIFY_EXPIRY=24h
JWT_ISSUER=depot-management-api
JWT_AUDIENCE=depot-management-client

# 2FA: AES-256-GCM key for encrypting TOTP secrets at rest (config/encryption.js).
# Must decode (base64) to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=


REDIS_URL=redis://localhost:6379

# Session (required if using Redis session store)
SESSION_SECRET=change-me-session-secret


CORS_ORIGIN=http://localhost:3000,http://localhost:5173


# Transactional email (password reset) via Resend's SMTP endpoint. Login is
# always the literal user "resend"; the password is a Resend API key. Leave
# SMTP_HOST empty to log emails instead of sending. SMTP_FROM must be on a
# domain verified at resend.com/domains (onboarding@resend.dev only delivers
# to the Resend account owner).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="Depot System <onboarding@resend.dev>"



# Security / rate limiting
ARCJET_ENV=development
ARCJET_KEY=
ENABLE_ARCJET=false
ENABLE_RATE_LIMIT=false

# Upstash Redis (sessions / cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: public base URL of this API (for links / logos)
TARGET_API=http://localhost:5000
COMPANY_LOGO_URL=

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=

LOG_FORMAT=pretty
# LOG_LEVEL=debug|info|warn|error; default: debug in development, info in production
LOG_LEVEL=debug
LOG_TO_FILE=false
# HTTP requests slower than this (ms) log a "Slow HTTP request" warning
LOG_SLOW_REQUEST_MS=1000
METRICS_ENABLED=true
# Required in production — without it GET /metrics is publicly readable.
# Prometheus must send it as `Authorization: Bearer <token>` (see monitoring/README.md).
METRICS_TOKEN=

# Cloudinary (optional photos for owner / manager / sale supervisor)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=depot-system
