generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Province {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  code      String?    @unique @db.VarChar(20)
  createdAt DateTime   @default(now()) @map("created_at")
  depots    Depot[]
  districts District[]

  @@map("provinces")
}

model District {
  id         Int      @id @default(autoincrement())
  provinceId Int      @map("province_id")
  name       String   @db.VarChar(100)
  code       String?  @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  depots     Depot[]
  province   Province @relation(fields: [provinceId], references: [id])

  @@map("districts")
}

model Employee {
  id                  Int                  @id @default(autoincrement())
  employeeCode        String?              @unique @map("employee_code") @db.VarChar(50)
  position            String?              @db.VarChar(100)
  phone               String?              @db.VarChar(20)
  email               String?              @db.VarChar(100)
  hireDate            DateTime?            @map("hire_date") @db.Date
  status              EmployeeStatus       @default(active)
  createdAt           DateTime             @default(now()) @map("created_at")
  address             String?
  dateOfBirth         DateTime?            @map("date_of_birth") @db.Date
  department          String?              @db.VarChar(100)
  englishName         String?              @map("english_name") @db.VarChar(100)
  gender              String?
  images              String?
  khmerName           String?              @map("khmer_name") @db.VarChar(100)
  salary              Float?               @db.Real
  updatedAt           DateTime?            @updatedAt @map("updated_at")
  remarks             String?
  depots              Depot[]
  documents           EmployeeDocument[]
  kpis                EmployeeKPI[]
  kpiValues           KpiValue[]
  user                User?

  @@index([khmerName, englishName], map: "idx_employees_names")
  @@map("employees")
}

model Depot {
  id            Int           @id @default(autoincrement())
  districtId    Int           @map("district_id")
  name          String        @db.VarChar(100)
  code          String?       @unique @db.VarChar(50)
  address       String?
  phone         String?       @db.VarChar(20)
  status        DepotStatus   @default(active)
  createdAt     DateTime      @default(now()) @map("created_at")
  commune       String?       @db.VarChar(100)
  employeeId    Int?          @map("employee_id")
  expiryDate    DateTime?     @map("expiry_date") @db.Timestamptz(6)
  houseNumber   String?       @map("house_number") @db.VarChar(50)
  provinceId    Int?          @map("province_id")
  street        String?       @db.VarChar(100)
  village       String?       @db.VarChar(100)
  brandId       Int?          @map("brand_id")
  assignedAt    DateTime?     @map("assigned_at")
  khmerName     String?       @map("khmer_name") @db.VarChar(100)
  dateOfBirth   DateTime?     @map("date_of_birth") @db.Date
  sex           Sex?          @default(male)
  DepotIdNumber String?       @map("Depot_id_number") @db.VarChar(20)
  note          String?
  district      District      @relation(fields: [districtId], references: [id])
  employee      Employee?     @relation(fields: [employeeId], references: [id])
  brand         Brand?        @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_brand")
  province      Province?     @relation(fields: [provinceId], references: [id], map: "fk_depot_province")
  kpis          EmployeeKPI[]
  staffs        Staff[]
  kpiValues     KpiValue[]
  brandMonthKpis BrandDepotMonthKpi[]

  @@index([createdAt], map: "idx_depots_created_at")
  @@index([districtId], map: "idx_depots_district_id")
  @@index([provinceId], map: "idx_depots_province_id")
  @@index([employeeId], map: "idx_depots_employee_id")
  @@index([name], map: "idx_name_depot")
  @@map("depots")
}

model Staff {
  id      Int     @id @default(autoincrement())
  depotId Int     @map("depot_id")
  name    String
  email   String? @unique
  phone   String? @db.VarChar(20)
  depot   Depot   @relation(fields: [depotId], references: [id])

  @@map("staffs")
}

model Brand {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(100)
  code        String?     @unique @db.VarChar(50)
  description String?
  logoUrl     String?     @map("logo_url") @db.VarChar(500)
  status      BrandStatus @default(active)
  createdAt   DateTime    @default(now()) @map("created_at")
  depots      Depot[]
  kpiValues   KpiValue[]
  kpiPackAssignments KpiPackAssignment[]
  brandMonthKpis BrandDepotMonthKpi[]

  @@map("brands")
}

model User {
  id           Int            @id @default(autoincrement())
  employeeId   Int?           @unique @map("employee_id")
  username     String         @unique @db.VarChar(50)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  role         UserRole       @default(staff)
  lastLogin    DateTime?      @map("last_login")
  status       UserStatus     @default(active)
  createdAt    DateTime       @default(now()) @map("created_at")
  refreshToken RefreshToken[]
  reports      Report[]
  employee     Employee?      @relation(fields: [employeeId], references: [id])

  @@map("users")
}

model Report {
  id          Int        @id @default(autoincrement())
  generatedBy Int        @map("generated_by")
  reportType  ReportType @map("report_type")
  title       String     @db.VarChar(200)
  parameters  Json?
  filePath    String?    @map("file_path") @db.VarChar(500)
  generatedAt DateTime   @default(now()) @map("generated_at")
  user        User       @relation(fields: [generatedBy], references: [id])

  @@map("reports")
}

model RefreshToken {
  id        String   @id @map("refresh_tokens_pkey")
  token     String   @unique @map("refresh_tokens_token_key")
  userId    Int      @map("user_id")
  isRevoked Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model EmployeeKPI {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  depotId     Int      @map("depot_id")
  month       DateTime @db.Date
  targetValue Float    @map("target_value")
  actualValue Float    @default(0) @map("actual_value")
  performance Float?
  remarks     String?
  createdAt   DateTime @default(now()) @map("created_at")
  depot       Depot    @relation(fields: [depotId], references: [id])
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, depotId, month])
  @@map("employee_kpis")
}

model EmployeeDocument {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  fileName   String   @map("file_name") @db.VarChar(200)
  fileUrl    String   @map("file_url")
  fileType   String?  @map("file_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_documents")
}

// ── Dynamic KPI (Approach B) ──────────────────────────────

enum KpiDirection {
  higher_better
  lower_better
}

enum KpiValueType {
  number
  percent
  currency
}

enum ImportBatchStatus {
  pending
  validating
  importing
  success
  failed
  partial
}

model KpiDefinition {
  id          Int          @id @default(autoincrement())
  code        String       @unique @db.VarChar(50)
  name        String       @db.VarChar(150)
  description String?
  unit        String?      @db.VarChar(30)
  valueType   KpiValueType @default(number) @map("value_type")
  direction   KpiDirection @default(higher_better)
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  values      KpiValue[]
  packItems   KpiPackItem[]

  @@map("kpi_definitions")
}

model KpiPack {
  id          Int                 @id @default(autoincrement())
  code        String              @unique @db.VarChar(50)
  name        String              @db.VarChar(150)
  description String?
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  items       KpiPackItem[]
  assignments KpiPackAssignment[]

  @@map("kpi_packs")
}

model KpiPackItem {
  id              Int           @id @default(autoincrement())
  packId          Int           @map("pack_id")
  kpiDefinitionId Int           @map("kpi_definition_id")
  weight          Float         @default(1)
  sortOrder       Int           @default(0) @map("sort_order")
  pack            KpiPack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)

  @@unique([packId, kpiDefinitionId])
  @@map("kpi_pack_items")
}

model KpiPackAssignment {
  id         Int     @id @default(autoincrement())
  packId     Int     @map("pack_id")
  brandId    Int?    @map("brand_id")
  department String? @db.VarChar(100)
  pack       KpiPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  brand      Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([brandId])
  @@map("kpi_pack_assignments")
}

model ImportBatch {
  id          Int               @id @default(autoincrement())
  fileName    String            @map("file_name") @db.VarChar(255)
  status      ImportBatchStatus @default(pending)
  periodMonth DateTime?         @map("period_month") @db.Date
  totalRows   Int               @default(0) @map("total_rows")
  successRows Int               @default(0) @map("success_rows")
  failedRows  Int               @default(0) @map("failed_rows")
  errorReport Json?             @map("error_report")
  uploadedBy  Int?              @map("uploaded_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  completedAt DateTime?         @map("completed_at")
  values      KpiValue[]

  @@map("import_batches")
}

model KpiValue {
  id              Int           @id @default(autoincrement())
  employeeId      Int           @map("employee_id")
  depotId         Int           @map("depot_id")
  brandId         Int?          @map("brand_id")
  kpiDefinitionId Int           @map("kpi_definition_id")
  periodMonth     DateTime      @map("period_month") @db.Date
  targetValue     Float?        @map("target_value")
  actualValue     Float         @default(0) @map("actual_value")
  score           Float?
  remarks         String?
  importBatchId   Int?          @map("import_batch_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt @map("updated_at")
  employee        Employee      @relation(fields: [employeeId], references: [id])
  depot           Depot         @relation(fields: [depotId], references: [id])
  brand           Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])
  importBatch     ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([employeeId, depotId, kpiDefinitionId, periodMonth], map: "kpi_values_natural_key")
  @@index([periodMonth, employeeId], map: "idx_kpi_values_period_employee")
  @@index([periodMonth, depotId], map: "idx_kpi_values_period_depot")
  @@index([kpiDefinitionId, periodMonth], map: "idx_kpi_values_def_period")
  @@index([importBatchId], map: "idx_kpi_values_batch")
  @@map("kpi_values")
}

model BrandDepotMonthKpi {
  id                  Int       @id @default(autoincrement())
  depotId             Int       @map("depot_id")
  brandId             Int       @map("brand_id")
  periodMonth         DateTime  @map("period_month") @db.Date
  poActual            Float     @default(0) @map("po_actual")
  poTarget            Float?    @map("po_target")
  productAvailablePct Float?    @map("product_available_pct")
  volumeDisplayPct    Float?    @map("volume_display_pct")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt @map("updated_at")
  brand               Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  depot               Depot     @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@unique([depotId, brandId, periodMonth], map: "brand_depot_month_kpis_natural_key")
  @@index([brandId, periodMonth], map: "idx_brand_depot_month_kpis_brand_period")
  @@index([depotId, periodMonth], map: "idx_brand_depot_month_kpis_depot_period")
  @@map("brand_depot_month_kpis")
}

enum Sex {
  male
  female
  other
}

enum DepotStatus {
  active
  inactive
  vacancy
  expired
}

enum BrandStatus {
  active
  inactive
}

enum EmployeeStatus {
  active
  inactive
}

enum UserRole {
  admin
  manager
  staff
  viewer
}

enum UserStatus {
  active
  locked
}

enum ReportType {
  inventory
  sales
  employee
  depot
}

enum DepotBrandStatus {
  active
  inactive
}
