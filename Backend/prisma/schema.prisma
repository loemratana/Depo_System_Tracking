generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Province {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  code      String?    @unique @db.VarChar(20)
  createdAt DateTime   @default(now()) @map("created_at")
  depots    Depot[]
  districts District[]

  @@map("provinces")
}

model District {
  id         Int      @id @default(autoincrement())
  provinceId Int      @map("province_id")
  name       String   @db.VarChar(100)
  code       String?  @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  depots     Depot[]
  province   Province @relation(fields: [provinceId], references: [id])

  @@map("districts")
}

model Employee {
  id           Int                @id @default(autoincrement())
  employeeCode String?            @unique @map("employee_code") @db.VarChar(50)
  position     String?            @db.VarChar(100)
  phone        String?            @db.VarChar(20)
  email        String?            @db.VarChar(100)
  hireDate     DateTime?          @map("hire_date") @db.Date
  status       EmployeeStatus     @default(active)
  createdAt    DateTime           @default(now()) @map("created_at")
  address      String?
  dateOfBirth  DateTime?          @map("date_of_birth") @db.Date
  department   String?            @db.VarChar(100)
  englishName  String?            @map("english_name") @db.VarChar(100)
  gender       String?
  images       String?
  khmerName    String?            @map("khmer_name") @db.VarChar(100)
  salary       Float?             @db.Real
  updatedAt    DateTime?          @updatedAt @map("updated_at")
  remarks      String?
  depots       Depot[]
  documents    EmployeeDocument[]
  kpis         EmployeeKPI[]
  kpiValues    KpiValue[]
  user         User?

  @@index([khmerName, englishName], map: "idx_employees_names")
  @@map("employees")
}

model Depot {
  id             Int                  @id @default(autoincrement())
  districtId     Int                  @map("district_id")
  name           String               @db.VarChar(100)
  code           String?              @unique @db.VarChar(50)
  address        String?
  phone          String?              @db.VarChar(20)
  status         DepotStatus          @default(active)
  createdAt      DateTime             @default(now()) @map("created_at")
  commune        String?              @db.VarChar(100)
  employeeId     Int?                 @map("employee_id")
  expiryDate     DateTime?            @map("expiry_date") @db.Timestamptz(6)
  houseNumber    String?              @map("house_number") @db.VarChar(50)
  provinceId     Int?                 @map("province_id")
  street         String?              @db.VarChar(100)
  village        String?              @db.VarChar(100)
  brandId        Int?                 @map("brand_id")
  assignedAt     DateTime?            @map("assigned_at")
  khmerName      String?              @map("khmer_name") @db.VarChar(100)
  dateOfBirth    DateTime?            @map("date_of_birth") @db.Date
  sex            Sex?                 @default(male)
  DepotIdNumber  String?              @map("Depot_id_number") @db.VarChar(20)
  note           String?
  /// Depot owner (person on the depot form — separate from sale supervisor)
  ownerPhotoUrl  String?              @map("owner_photo_url") @db.VarChar(500)
  managerId      Int?                 @map("manager_id")
  district       District             @relation(fields: [districtId], references: [id])
  employee       Employee?            @relation(fields: [employeeId], references: [id])
  manager        Manager?             @relation(fields: [managerId], references: [id])
  brand          Brand?               @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_brand")
  province       Province?            @relation(fields: [provinceId], references: [id], map: "fk_depot_province")
  kpis           EmployeeKPI[]
  staffs         Staff[]
  kpiValues      KpiValue[]
  brandMonthKpis BrandDepotMonthKpi[]
  assessments    DepotAssessment[]

  @@index([createdAt], map: "idx_depots_created_at")
  @@index([districtId], map: "idx_depots_district_id")
  @@index([provinceId], map: "idx_depots_province_id")
  @@index([employeeId], map: "idx_depots_employee_id")
  @@index([managerId], map: "idx_depots_manager_id")
  @@index([name], map: "idx_name_depot")
  @@map("depots")
}

model Staff {
  id      Int     @id @default(autoincrement())
  depotId Int     @map("depot_id")
  name    String
  email   String? @unique
  phone   String? @db.VarChar(20)
  depot   Depot   @relation(fields: [depotId], references: [id])

  @@map("staffs")
}

model Manager {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  photoUrl  String?  @map("photo_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  depots Depot[]

  @@map("managers")
}

model Brand {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(100)
  code               String?              @unique @db.VarChar(50)
  description        String?
  logoUrl            String?              @map("logo_url") @db.VarChar(500)
  status             BrandStatus          @default(active)
  createdAt          DateTime             @default(now()) @map("created_at")
  depots             Depot[]
  kpiValues          KpiValue[]
  kpiPackAssignments KpiPackAssignment[]
  brandMonthKpis     BrandDepotMonthKpi[]
  telegramChats      TelegramChat[]

  @@map("brands")
}

model TelegramChat {
  id        Int      @id @default(autoincrement())
  chatId    String   @unique @map("chat_id") @db.VarChar(50)
  brandId   Int      @map("brand_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([brandId, isActive])
  @@map("telegram_chats")
}

model User {
  id           Int            @id @default(autoincrement())
  employeeId   Int?           @unique @map("employee_id")
  username     String         @unique @db.VarChar(50)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  role         UserRole       @default(staff)
  lastLogin    DateTime?      @map("last_login")
  status       UserStatus     @default(active)
  createdAt    DateTime       @default(now()) @map("created_at")
  refreshToken RefreshToken[]
  reports      Report[]
  employee     Employee?      @relation(fields: [employeeId], references: [id])
  assessmentsEvaluated DepotAssessment[]      @relation("AssessmentEvaluator")
  assessmentAuditEvents AssessmentAuditEvent[] @relation("AssessmentAuditActor")
  auditLogs             AuditLog[]             @relation("AuditLogActor")
  twoFactor             UserTwoFactor?
  webauthnCredentials   WebAuthnCredential[]
  recoveryCodes         RecoveryCode[]

  @@map("users")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(100)
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  role         UserRole
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model Report {
  id          Int        @id @default(autoincrement())
  generatedBy Int        @map("generated_by")
  reportType  ReportType @map("report_type")
  title       String     @db.VarChar(200)
  parameters  Json?
  filePath    String?    @map("file_path") @db.VarChar(500)
  generatedAt DateTime   @default(now()) @map("generated_at")
  user        User       @relation(fields: [generatedBy], references: [id])

  @@map("reports")
}

// Persists issued refresh tokens for revocation/rotation (see
// authService.js). The underlying columns are literally named
// "refresh_tokens_pkey"/"refresh_tokens_token_key" — an old migration
// (prisma/migrations/20260529071700) accidentally used Postgres's default
// constraint-naming convention as the actual column names. Left alone here
// deliberately (renaming physical columns is a real migration with real
// risk for zero functional benefit — @map already fully hides the ugliness
// from every consumer of this model); `token` -> `tokenHash` below is a
// Prisma-side field rename only (same @map, same column) since this field
// now stores a SHA-256 hash of the refresh token, never the raw value.
model RefreshToken {
  id        String   @id @map("refresh_tokens_pkey")
  tokenHash String   @unique @map("refresh_tokens_token_key")
  userId    Int      @map("user_id")
  isRevoked Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model EmployeeKPI {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  depotId     Int      @map("depot_id")
  month       DateTime @db.Date
  targetValue Float    @map("target_value")
  actualValue Float    @default(0) @map("actual_value")
  performance Float?
  remarks     String?
  createdAt   DateTime @default(now()) @map("created_at")
  depot       Depot    @relation(fields: [depotId], references: [id])
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, depotId, month])
  @@map("employee_kpis")
}

model EmployeeDocument {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  fileName   String   @map("file_name") @db.VarChar(200)
  fileUrl    String   @map("file_url")
  fileType   String?  @map("file_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_documents")
}

// ── Dynamic KPI (Approach B) ──────────────────────────────

enum KpiDirection {
  higher_better
  lower_better
}

enum KpiValueType {
  number
  percent
  currency
}

enum ImportBatchStatus {
  pending
  validating
  importing
  success
  failed
  partial
}

model KpiDefinition {
  id          Int           @id @default(autoincrement())
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(150)
  description String?
  unit        String?       @db.VarChar(30)
  valueType   KpiValueType  @default(number) @map("value_type")
  direction   KpiDirection  @default(higher_better)
  isActive    Boolean       @default(true) @map("is_active")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  values      KpiValue[]
  packItems   KpiPackItem[]

  @@map("kpi_definitions")
}

model KpiPack {
  id          Int                 @id @default(autoincrement())
  code        String              @unique @db.VarChar(50)
  name        String              @db.VarChar(150)
  description String?
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  items       KpiPackItem[]
  assignments KpiPackAssignment[]

  @@map("kpi_packs")
}

model KpiPackItem {
  id              Int           @id @default(autoincrement())
  packId          Int           @map("pack_id")
  kpiDefinitionId Int           @map("kpi_definition_id")
  weight          Float         @default(1)
  sortOrder       Int           @default(0) @map("sort_order")
  pack            KpiPack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)

  @@unique([packId, kpiDefinitionId])
  @@map("kpi_pack_items")
}

model KpiPackAssignment {
  id         Int     @id @default(autoincrement())
  packId     Int     @map("pack_id")
  brandId    Int?    @map("brand_id")
  department String? @db.VarChar(100)
  pack       KpiPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  brand      Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([brandId])
  @@map("kpi_pack_assignments")
}

model ImportBatch {
  id          Int               @id @default(autoincrement())
  fileName    String            @map("file_name") @db.VarChar(255)
  status      ImportBatchStatus @default(pending)
  periodMonth DateTime?         @map("period_month") @db.Date
  totalRows   Int               @default(0) @map("total_rows")
  successRows Int               @default(0) @map("success_rows")
  failedRows  Int               @default(0) @map("failed_rows")
  errorReport Json?             @map("error_report")
  uploadedBy  Int?              @map("uploaded_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  completedAt DateTime?         @map("completed_at")
  values      KpiValue[]

  @@map("import_batches")
}

model KpiValue {
  id              Int           @id @default(autoincrement())
  employeeId      Int           @map("employee_id")
  depotId         Int           @map("depot_id")
  brandId         Int?          @map("brand_id")
  kpiDefinitionId Int           @map("kpi_definition_id")
  periodMonth     DateTime      @map("period_month") @db.Date
  targetValue     Float?        @map("target_value")
  actualValue     Float         @default(0) @map("actual_value")
  score           Float?
  remarks         String?
  importBatchId   Int?          @map("import_batch_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt @map("updated_at")
  employee        Employee      @relation(fields: [employeeId], references: [id])
  depot           Depot         @relation(fields: [depotId], references: [id])
  brand           Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])
  importBatch     ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([employeeId, depotId, kpiDefinitionId, periodMonth], map: "kpi_values_natural_key")
  @@index([periodMonth, employeeId], map: "idx_kpi_values_period_employee")
  @@index([periodMonth, depotId], map: "idx_kpi_values_period_depot")
  @@index([kpiDefinitionId, periodMonth], map: "idx_kpi_values_def_period")
  @@index([importBatchId], map: "idx_kpi_values_batch")
  @@map("kpi_values")
}

model BrandDepotMonthKpi {
  id                  Int       @id @default(autoincrement())
  depotId             Int       @map("depot_id")
  brandId             Int       @map("brand_id")
  periodMonth         DateTime  @map("period_month") @db.Date
  poActual            Float     @default(0) @map("po_actual")
  poTarget            Float?    @map("po_target")
  productAvailablePct Float?    @map("product_available_pct")
  volumeDisplayPct    Float?    @map("volume_display_pct")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt @map("updated_at")
  brand               Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  depot               Depot     @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@unique([depotId, brandId, periodMonth], map: "brand_depot_month_kpis_natural_key")
  @@index([brandId, periodMonth], map: "idx_brand_depot_month_kpis_brand_period")
  @@index([depotId, periodMonth], map: "idx_brand_depot_month_kpis_depot_period")
  @@map("brand_depot_month_kpis")
}

// ── Depot Assessment ──────────────────────────────────────

model AssessmentCycle {
  id          Int                 @id @default(autoincrement())
  type        AssessmentCycleType
  label       String              @db.VarChar(100)
  periodStart DateTime            @map("period_start") @db.Date
  periodEnd   DateTime            @map("period_end") @db.Date
  createdAt   DateTime            @default(now()) @map("created_at")
  assessments DepotAssessment[]

  @@map("assessment_cycles")
}

model AssessmentCriterion {
  id                 Int                          @id @default(autoincrement())
  code               String                       @unique @db.VarChar(50)
  labelKm            String                       @map("label_km")
  category           AssessmentCriterionCategory
  isStructural       Boolean                      @default(false) @map("is_structural")
  isComparable       Boolean                      @default(true) @map("is_comparable")
  needsClarification Boolean                      @default(false) @map("needs_clarification")
  sortOrder          Int                          @default(0) @map("sort_order")
  isActive           Boolean                      @default(true) @map("is_active")
  items              DepotAssessmentItem[]

  @@map("assessment_criteria")
}

/// At most one non-superseded row may exist per (depotId, cycleId) — enforced
/// in the database by a partial unique index (migration
/// 20260911090000_add_unique_active_assessment_per_depot_cycle:
/// `idx_depot_assessments_active_unique` on (depot_id, cycle_id) WHERE
/// is_superseded = false). Prisma's schema DSL can't express a partial/
/// filtered unique index, so it isn't declared below with `@@unique` —
/// this comment is the only place it's documented on the model side.
model DepotAssessment {
  id                   Int                    @id @default(autoincrement())
  depotId              Int                    @map("depot_id")
  cycleId              Int                    @map("cycle_id")
  evaluatorId          Int                    @map("evaluator_id")
  /// Free-typed evaluator name shown in place of the account username
  /// (evaluatorId stays the logged-in user who created/owns the record for
  /// permissions and audit; this is display-only and not tied to a User row).
  evaluatorName        String?                @map("evaluator_name") @db.VarChar(150)
  status               DepotAssessmentStatus  @default(draft)
  version              Int                    @default(1)
  isSuperseded         Boolean                @default(false) @map("is_superseded")
  reopenedFromId       Int?                   @unique @map("reopened_from_id")
  reopenReason         String?                @map("reopen_reason")
  assessmentDate       DateTime               @map("assessment_date") @db.Date
  submittedAt          DateTime?              @map("submitted_at")
  finalizedAt          DateTime?              @map("finalized_at")
  overallScore         Decimal?               @map("overall_score") @db.Decimal(5, 2)
  ourWinsCount         Int                    @default(0) @map("our_wins_count")
  competitorWinsCount  Int                    @default(0) @map("competitor_wins_count")
  notComparedCount     Int                    @default(0) @map("not_compared_count")
  qualificationStatus  QualificationStatus?   @map("qualification_status")
  qualificationReason  String?                @map("qualification_reason")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime?              @updatedAt @map("updated_at")

  depot        Depot                  @relation(fields: [depotId], references: [id])
  cycle        AssessmentCycle        @relation(fields: [cycleId], references: [id])
  evaluator    User                   @relation("AssessmentEvaluator", fields: [evaluatorId], references: [id])
  reopenedFrom DepotAssessment?       @relation("AssessmentReopen", fields: [reopenedFromId], references: [id])
  reopenedInto DepotAssessment?       @relation("AssessmentReopen")
  items        DepotAssessmentItem[]
  auditEvents  AssessmentAuditEvent[]

  @@index([depotId, cycleId], map: "idx_depot_assessments_depot_cycle")
  @@index([cycleId], map: "idx_depot_assessments_cycle_id")
  @@index([evaluatorId], map: "idx_depot_assessments_evaluator_id")
  @@index([status], map: "idx_depot_assessments_status")
  // Two more indexes exist in the DB (migration 20260912020000_add_
  // assessment_list_indexes) but aren't declared below: a partial index
  // `idx_depot_assessments_active_date` on (assessment_date DESC) WHERE
  // is_superseded = false — Prisma's DSL can't express the WHERE — serving
  // the default list/export query (isSuperseded=false, ordered by date);
  // and `idx_depot_assessments_cycle_status_date` on (cycleId, status,
  // assessmentDate DESC), which *could* be declared here via
  // `@@index([cycleId, status, assessmentDate(sort: Desc)])` but is kept
  // in the same hand-written migration as its partial sibling for one
  // source of truth. Verified via EXPLAIN at realistic scale (350 rows)
  // that Postgres actually picks up both.
  @@map("depot_assessments")
}

model DepotAssessmentItem {
  id           Int                  @id @default(autoincrement())
  assessmentId Int                  @map("assessment_id")
  criterionId  Int                  @map("criterion_id")
  score        Int?
  result       AssessmentItemResult @default(none)
  remarks      String?

  assessment DepotAssessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterion  AssessmentCriterion @relation(fields: [criterionId], references: [id])

  @@unique([assessmentId, criterionId], map: "depot_assessment_items_assessment_criterion_key")
  @@index([criterionId], map: "idx_depot_assessment_items_criterion_id")
  @@map("depot_assessment_items")
}

model AssessmentAuditEvent {
  id           Int                   @id @default(autoincrement())
  assessmentId Int                   @map("assessment_id")
  action       AssessmentAuditAction
  actorId      Int                   @map("actor_id")
  note         String?
  createdAt    DateTime              @default(now()) @map("created_at")

  assessment DepotAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  actor      User            @relation("AssessmentAuditActor", fields: [actorId], references: [id])

  @@index([assessmentId], map: "idx_assessment_audit_events_assessment_id")
  @@map("assessment_audit_events")
}

model UserTwoFactor {
  id               Int             @id @default(autoincrement())
  userId           Int             @unique @map("user_id")
  method           TwoFactorMethod @default(totp)
  secretCiphertext Bytes           @map("secret_ciphertext")
  secretIv         Bytes           @map("secret_iv")
  secretAuthTag    Bytes           @map("secret_auth_tag")
  keyVersion       Int             @default(1) @map("key_version")
  isVerified       Boolean         @default(false) @map("is_verified")
  createdAt        DateTime        @default(now()) @map("created_at")
  verifiedAt       DateTime?       @map("verified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_two_factor")
}
// One row per user's TOTP enrollment (@unique userId). isVerified gates whether
// login actually enforces it — a half-completed setup must not lock anyone out
// or silently half-enable 2FA. Secret is never stored plaintext.

model WebAuthnCredential {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    Bytes    @map("public_key")
  counter      BigInt   @default(0)
  deviceName   String?  @map("device_name")
  transports   String[] @map("transports")
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId], map: "idx_webauthn_credentials_user_id")
  @@map("webauthn_credentials")
}
// Multiple rows per user (one per passkey/security key), unlike UserTwoFactor's
// one-per-user TOTP secret. counter must be checked non-decreasing on every
// auth — standard WebAuthn cloned-authenticator detection.

model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId], map: "idx_recovery_codes_user_id")
  @@map("recovery_codes")
}
// One row per generated code (typically 10/batch). Regeneration deletes all
// prior rows in the SAME transaction that inserts the new batch — mirrors
// authService.resetPassword's existing $transaction pattern.

enum TwoFactorMethod {
  totp
}


// General-purpose, system-wide audit trail — distinct from
// AssessmentAuditEvent above, which only covers the assessment lifecycle.
// Table already exists in the dev DB (created directly via SQL, not a
// Prisma migration) — see prisma/migrations/20260915000000_add_audit_logs,
// whose CREATE TABLE/INDEX statements are written IF NOT EXISTS so applying
// it against a DB that already has this table is a safe no-op.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     Int?     @map("user_id")
  username   String?  @db.VarChar(100)
  action     String   @db.VarChar(50)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  requestId  String?  @map("request_id") @db.VarChar(100)
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent")
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation("AuditLogActor", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId], map: "idx_audit_logs_user_id")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

