# Copy to monitoring/.env and adjust if needed
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001

# Local Docker Postgres (matches Backend/.env on port 5433)
POSTGRES_EXPORTER_DSN=postgresql://postgres:password@host.docker.internal:5433/depot?sslmode=disable

# Alertmanager -> Telegram (same bot the app already uses is fine)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Grafana Alloy — stamped onto every collected container's log lines as the
# `environment`/`host` Loki labels (see alloy/config.alloy). ALLOY_HOST
# should identify the actual VPS if you run this stack in more than one
# place (e.g. "dokploy-vps-1").
ALLOY_ENVIRONMENT=production
ALLOY_HOST=depot-vps
